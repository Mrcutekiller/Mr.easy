{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MR.easy",
  "patterns": [
    { "include": "#comments" },
    { "include": "#declaration" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#logic" },
    { "include": "#modifiers" },
    { "include": "#properties" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.mreasy",
      "match": "#.*$"
    },
    "declaration": {
      "name": "keyword.other.declaration.mreasy",
      "match": "\\bMr\\.easy\\b"
    },
    "strings": {
      "name": "string.quoted.double.mreasy",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.mreasy",
          "match": "\\\\."
        },
        {
          "name": "variable.other.interpolation.mreasy",
          "match": "\\{[a-zA-Z_]+\\}"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.mreasy",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "keywords": {
      "name": "keyword.control.mreasy",
      "match": "\\b(nav|hero|section|header|footer|row|column|col|grid|card|box|list|form|title|subtitle|text|label|item|button|link|image|img|video|icon|input|logo|links|menu|divider|spacer|animate|component|use|function|call|define|import|from|accordion|tabs|tab|table|thead|tbody|tr|th|td|badge|tag|alert|progress|avatar|quote|code|stat|select|checkbox|toggle|embed|rating|countdown|steps|step|testimonial|page|sidebar|modal|dropdown|head|meta)\\b"
    },
    "logic": {
      "name": "keyword.other.logic.mreasy",
      "match": "\\b(set|repeat|times|if|else|end|show|hide|for|while|each|in|of|to)\\b"
    },
    "modifiers": {
      "name": "entity.other.attribute-name.mreasy",
      "match": "\\b(big|medium|small|tiny|glow|shadow|rounded|outline|bold|italic|dark|light|gradient|glass|center|left|right|blue|red|green|purple|orange|pink|yellow|white|black|gray|cyan|on|off|float|autoplay|required|ordered|done|checked|success|warning|error|info|inline|fade-in|slide-up|pulse|bounce|email-format)\\b"
    },
    "properties": {
      "name": "variable.parameter.mreasy",
      "match": "\\b[a-zA-Z_][\\w-]*:"
    }
  },
  "scopeName": "source.mreasy"
}
